rules_version = '2';

// ============================================================
//  Regras de segurança do GymEats
//  Cole isto em: console.firebase.google.com > Firestore Database
//  > aba "Regras" > Publicar.
//
//  Ideia geral: só quem está logado enxerga qualquer coisa, e só
//  quem é membro de um desafio enxerga o conteúdo dele.
// ============================================================

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isSelf(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    function challengeData(cid) {
      return get(/databases/$(database)/documents/challenges/$(cid)).data;
    }

    function isMember(cid) {
      return signedIn() && request.auth.uid in challengeData(cid).memberUids;
    }

    // Admin do app (eu e a Valentina). A lista mora em admins/{uid} e é
    // criada à mão no console — nem o próprio admin escreve nela pelo app.
    function isAdmin() {
      return signedIn()
             && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    function isOwner(cid) {
      return signedIn() && request.auth.uid == challengeData(cid).ownerUid;
    }

    // ---------- Quem é admin ----------
    // Leitura liberada pra logados: a tela precisa saber se mostra o painel,
    // e a lista não revela nada além de dois ids que já são públicos no app.
    match /admins/{uid} {
      allow read: if signedIn();
      allow write: if false;
    }

    // ---------- Diário de erros ----------
    // Qualquer um registra o próprio erro; só admin lê. É o que permite
    // enxergar a falha de quem está do outro lado sem pedir print.
    match /logs/{logId} {
      allow create: if signedIn() && request.resource.data.uid == request.auth.uid;
      allow read, delete: if isAdmin();
      allow update: if false;
    }

    // ---------- Perfis ----------
    match /users/{uid} {
      allow read: if signedIn();
      allow create, update: if isSelf(uid);
      allow delete: if false;

      // Registro de notificação deste aparelho. Só o dono enxerga e mexe;
      // as Cloud Functions leem pelo Admin SDK, que passa por cima daqui.
      match /pushTokens/{tokenId} {
        allow read, write: if isSelf(uid);
      }

      // Contador diário de estimativas — escrito só pela função.
      match /uso/{dia} {
        allow read: if isSelf(uid) || isAdmin();
        allow write: if false;
      }
    }

    // ---------- Códigos de convite ----------
    // Qualquer pessoa logada pode resolver um código (é assim que se entra
    // num desafio). O código não revela nada além do id do desafio.
    match /codes/{code} {
      allow read: if signedIn();
      allow create: if signedIn();
      allow update, delete: if false;
    }

    // ---------- Desafios ----------
    match /challenges/{cid} {
      // Só pode mexer na lista de membros, e só na própria entrada.
      function onlyToggledOwnMembership() {
        let before = resource.data.memberUids;
        let after = request.resource.data.memberUids;
        let me = request.auth.uid;
        return signedIn()
               && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['memberUids'])
               && ((!(me in before) && after == before.concat([me]))
                   || ((me in before) && after == before.removeAll([me])));
      }

      allow read: if signedIn() && request.auth.uid in resource.data.memberUids;
      allow create: if signedIn()
                    && request.resource.data.ownerUid == request.auth.uid
                    && request.resource.data.memberUids == [request.auth.uid];
      allow update: if isOwner(cid) || onlyToggledOwnMembership();
      allow delete: if isOwner(cid);

      // ---------- Ficha de membro (placar) ----------
      match /members/{uid} {
        allow read: if isMember(cid);
        // cada um mexe na própria ficha; o dono também mexe nas dos outros,
        // porque é ele quem recalcula o placar ao apagar um post alheio
        allow create, update: if isSelf(uid) || isOwner(cid);
        allow delete: if isSelf(uid) || isOwner(cid);
      }

      // ---------- Posts ----------
      match /posts/{pid} {
        allow read: if isMember(cid);
        allow create: if isMember(cid) && request.resource.data.uid == request.auth.uid;

        // Qualquer membro pode reagir, dar nota e chutar o preço.
        // O resto do post só o autor mexe.
        // Obs.: nota e palpite de terceiro não são validados campo a campo —
        // é um app entre amigos, e o custo de blindar isso não compensa.
        // O DONO do desafio (e só ele) pode arrumar a data e a localização
        // de um prato alheio — é o zelador do desafio. Continua sem poder
        // mexer em foto, título, nota ou qualquer outra coisa.
        allow update: if isMember(cid) && (
                        resource.data.uid == request.auth.uid ||
                        request.resource.data.diff(resource.data).affectedKeys()
                          .hasOnly(['reactions', 'commentCount', 'ratings',
                                    'ratingAvg', 'ratingCount', 'guesses',
                                    'kcalGuesses']) ||
                        (isOwner(cid) && request.resource.data.diff(resource.data)
                          .affectedKeys().hasOnly(['at', 'dayKey', 'dateEditada',
                                                   'place', 'placeKey', 'coords']))
                      );
        allow delete: if isMember(cid) && (resource.data.uid == request.auth.uid || isOwner(cid));

        match /comments/{commentId} {
          allow read: if isMember(cid);
          allow create: if isMember(cid) && request.resource.data.uid == request.auth.uid;
          allow update: if false;
          allow delete: if isMember(cid) && (resource.data.uid == request.auth.uid || isOwner(cid));
        }
      }

      // ---------- Guia: lugares visitados ----------
      // Qualquer membro cria e atualiza (contagem de visitas e nota média
      // do lugar são somadas por quem posta ou dá nota).
      match /places/{placeId} {
        allow read: if isMember(cid);
        allow create, update: if isMember(cid);
        allow delete: if isOwner(cid);
      }

      // ---------- Histórico de notificações ----------
      // Quem escreve são as Cloud Functions, pelo Admin SDK. Do app é só
      // leitura, e só pra quem é do desafio.
      match /notifications/{logId} {
        allow read: if isMember(cid);
        allow write: if false;
      }

      // ---------- Bate-papo ----------
      match /messages/{mid} {
        allow read: if isMember(cid);
        allow create: if isMember(cid) && request.resource.data.uid == request.auth.uid;
        allow update: if false;
        allow delete: if isMember(cid) && (resource.data.uid == request.auth.uid || isOwner(cid));
      }
    }

    // ---------- Fotos em tamanho cheio ----------
    // Ficam numa coleção própria pro feed não precisar baixá-las.
    // O id é aleatório e imprevisível; qualquer pessoa logada que tenha
    // o id pode ler (é o que permite o feed funcionar sem consultas caras).
    // ---------- Base de alimentos do grupo ----------
    // Quem escreve é só a Cloud Function (admin SDK ignora estas regras).
    // Deixar o cliente gravar aqui abriria a porta pra alguém plantar
    // caloria errada num prato que todo mundo repete.
    match /alimentos/{chave} {
      allow read: if signedIn();
      // Escrita normal é só da Cloud Function; admin pode apagar uma entrada
      // que a IA envenenou, senão o erro se repete em todo prato igual.
      allow write: if false;
      allow delete: if isAdmin();
    }

    match /photos/{photoId} {
      allow read: if signedIn();
      allow create: if signedIn() && request.resource.data.uid == request.auth.uid;
      allow update: if false;
      allow delete: if signedIn() && resource.data.uid == request.auth.uid;
    }
  }
}
